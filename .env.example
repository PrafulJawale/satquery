# SatQuery AI -- optional environment variables (NAMES ONLY, no values).
#
# Nothing here is required to run the application. SatQuery needs no API key:
# base-map tiles are proxied by this app's own server, and place search uses
# the public OpenStreetMap Nominatim service with a descriptive User-Agent and
# a one-request-per-second limit (see core/geocode.py).
#
# Copy to `.env` only if you want to override a default. `.env` is gitignored.

# Where the tile proxy caches downloaded map tiles on disk.
SATQUERY_TILE_CACHE=/tmp/satquery_tile_cache

# Where fetched external datasets (land cover, soil, climate) are cached.
SATQUERY_EXTERNAL_DIR=data/external

# Streamlit server options, if you prefer them here to CLI flags.
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_ADDRESS=0.0.0.0
